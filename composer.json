{
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/ai": "^1.5",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_ckeditor": "^1.4",
        "drupal/ai_integration_eca": "^1.0",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/ai_search": "^1.3@alpha",
        "drupal/ai_tmgmt": "^1.0@beta",
        "drupal/ai_vdb_provider_postgres": "^1.0@alpha",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/devel": "^5.5",
        "drupal/eca": "^3.1",
        "drupal/modeler": "^1.0",
        "drupal/modeler_api": "^1.1",
        "drupal/search_api": "^1.43",
        "drupal/tmgmt": "^1.19",
        "drupal/token": "^1.18",
        "drush/drush": "^13.8"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/ai": {
                "Issue #3586747: ImageAltText field widget action no longer fills the alt field in the media library add form": "https://git.drupalcode.org/project/ai/-/merge_requests/2039.patch"
            }
        }
    }
}
